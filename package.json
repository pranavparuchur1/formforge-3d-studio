{
  "name": "formforge-3d-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive browser-based 3D modeling studio with zero-install local server.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "check": "node --check src/main.js && node --check src/scene-core.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.25.12",
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
